FROM python:3.11-slim
RUN pip install --no-cache-dir "mlflow==3.17.2"
# MLflow 3 starts a background job system (7 extra processes, ~2.2 GB) that experiment
# tracking does not need; with it off the server uses ~0.5 GB (measured).
ENV MLFLOW_SERVER_ENABLE_JOB_EXECUTION=false
EXPOSE 5000
# Data lives on a host mount (see infra/terraform/local) so runs survive pod restarts.
# One web worker is plenty for one agent; the default (4) was OOM-killed in the cluster.
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--workers", "1", \
     "--backend-store-uri", "sqlite:////mlflow-data/mlflow.db", \
     "--artifacts-destination", "/mlflow-data/artifacts"]
